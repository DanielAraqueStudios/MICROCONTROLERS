            sprintf(debug_text, "UART status: ISR=0x%lX", uart_status);
            SendDebugMessage(debug_text);
        }
          // State machine for robot movement
        switch (estado_actual) {
            case ESTADO_DETENIDO:
                // Robot is stopped, waiting for commands
                MotorControl(0, 0);
                break;                case ESTADO_AVANZANDO_Y:
                // Move along Y axis
                if (MoveDistance(abs((int)(target_y * TICK_FACTOR)))) {
                    // Y movement complete
