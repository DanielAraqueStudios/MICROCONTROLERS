            // Debug output (approximately every second)
            if (debug_counter % 100 == 0) {
                sprintf(debug_text, "Distance: %.1f cm, Servo: %d deg", current_distance, servo_position);
                SendDebugMessage(debug_text);
            }
        }
        
        // Check for obstacles during movement states
        if (obstacle_detected && 
            (estado_actual == ESTADO_AVANZANDO_Y || 
             estado_actual == ESTADO_AVANZANDO_X || 
             estado_actual == ESTADO_GIRANDO)) {
            
            // Change to obstacle state
            estado_actual = ESTADO_OBSTACULO;
            SendDebugMessage("Changing to obstacle state");
