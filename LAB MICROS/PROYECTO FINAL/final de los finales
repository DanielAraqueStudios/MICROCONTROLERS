void ConfigureUART(void) {
    // Enable GPIOD clock
    RCC->AHB1ENR |= (1 << 3);
    
    // Configure PD8 (TX) and PD9 (RX) for USART3
    GPIOD->MODER &= ~((3 << 16) | (3 << 18));
    GPIOD->MODER |= ((2 << 16) | (2 << 18));     // Alternate function
    GPIOD->AFR[1] &= ~((15 << 0) | (15 << 4));
    GPIOD->AFR[1] |= ((7 << 0) | (7 << 4));      // AF7 (USART3)
    
    // Enable USART3 clock
    RCC->APB1ENR |= (1 << 18);
    
    // Disable USART3 before configuring
    USART3->CR1 &= ~(1 << 0);
    
    // Configure USART3 for 9600 baud @ 16MHz
    USART3->BRR = 0x683;
    
    // Enable error interrupts along with RXNE
    USART3->CR1 |= ((1 << 5) | (1 << 2) | (1 << 3));  // RXNE interrupt, TX/RX enable
    
    // Enable hardware flow control if pins are available
    // USART3->CR3 |= (1 << 8) | (1 << 9);  // CTS and RTS enable
    
    // Set oversampling to 16
    USART3->CR1 &= ~(1 << 15);
    
    // Enable USART3
    USART3->CR1 |= (1 << 0);
    
    // Clear error flags if any are set
    USART3->ICR = 0x1F;
    
    // Initialize UART receive buffer
    for (int i = 0; i < UART_BUFFER_SIZE; i++) {
        uart_buffer[i] = 0;
    }
    uart_index = 0;
    uart_complete = false;
    
    // Enable USART3 interrupt in NVIC
    NVIC_SetPriority(USART3_IRQn, 0);  // Set high priority
    NVIC_EnableIRQ(USART3_IRQn);
    
    // Send test message to confirm UART is working
    SendDebugMessage("UART initialized successfully");
}

void ProcessUARTMessage(void) {
    char debug_buffer[50];
    
    // Remove CR/LF and null-terminate
    for (int i = 0; i < uart_index; i++) {
        if (uart_buffer[i] == '\r' || uart_buffer[i] == '\n') {
            uart_buffer[i] = '\0';
            break;
        }
    }
    
    // Make a clean copy of the message with leading/trailing whitespace removed
    char clean_buffer[UART_BUFFER_SIZE];
    int start = 0, end = strlen(uart_buffer) - 1;
    
    // Skip leading whitespace
    while (uart_buffer[start] == ' ' || uart_buffer[start] == '\t') {
        start++;
    }
    
    // Skip trailing whitespace
    while (end >= start && (uart_buffer[end] == ' ' || uart_buffer[end] == '\t' || 
           uart_buffer[end] == '\r' || uart_buffer[end] == '\n')) {
        end--;
    }
    
    // Copy cleaned message
    int clean_len = end - start + 1;
    if (clean_len > 0) {
        strncpy(clean_buffer, uart_buffer + start, clean_len);
    }
    clean_buffer[clean_len > 0 ? clean_len : 0] = '\0';
    
    // Print raw and cleaned message for debugging
    sprintf(debug_buffer, "Raw message: '%s'", uart_buffer);
    SendDebugMessage(debug_buffer);
    sprintf(debug_buffer, "Cleaned: '%s' (len=%d)", clean_buffer, clean_len);
    SendDebugMessage(debug_buffer);
    
    // If message is empty after trimming, ignore it
    if (clean_len <= 0) {
        SendDebugMessage("Empty message, ignoring");
        return;
    }
    
    // Make a lowercase copy for command checking
    char lower_buffer[UART_BUFFER_SIZE];
    for (int i = 0; i <= clean_len; i++) {
        lower_buffer[i] = tolower(clean_buffer[i]);
    }
    
    // Check for "stop" command (case insensitive)
    if (strcmp(lower_buffer, "stop") == 0) {
        // Emergency stop - halt all movement immediately
        MotorControl(0, 0);
        estado_actual = ESTADO_DETENIDO;
        SendDebugMessage("EMERGENCY STOP ACTIVATED");
        
        // Update LCD
        LCD_SetCursor(0, 0);
        LCD_Print("STOP            ");
        LCD_SetCursor(1, 0);
        LCD_Print("                ");
        return;
    } 
      // Check for "calibrate" command (case insensitive)
    if (strcmp(lower_buffer, "calibrate") == 0) {
        // Calibrate gyroscope
        SendDebugMessage("Starting gyroscope calibration...");
        MotorControl(0, 0);
        estado_actual = ESTADO_DETENIDO;
        CalibrateGyroscope();
        return;
    }
      // Check for "scan" command (case insensitive)
    if (strcmp(lower_buffer, "scan") == 0) {
        // Perform a complete obstacle scan
        SendDebugMessage("Performing full obstacle scan...");
        MotorControl(0, 0);
        estado_actual = ESTADO_DETENIDO;
        
        // Show scanning message on LCD
        LCD_SetCursor(0, 0);
        LCD_Print("Escaneando...   ");
        LCD_SetCursor(1, 0);
        LCD_Print("                ");
        
        // Perform a full 180-degree scan
        for (int angle = 0; angle <= 180; angle += 5) {
            SetServoPosition(angle);
            SysTick_ms(50);  // Give servo time to move
            
            float distance = ReadUltrasonicDistance();
            if (distance > 0.0f) {
                sprintf(debug_text, "Scan %d deg: %.1f cm", angle, distance);
                SendDebugMessage(debug_text);
                
                // Update LCD with current scan results
                sprintf(debug_text, "Ang:%3d Dist:%4.1f", angle, distance);
                LCD_SetCursor(1, 0);
                LCD_Print(debug_text);
                
                // Check for obstacle
                if (distance <= OBSTACLE_THRESHOLD) {
                    // Record obstacle
                    obstacle_detected = true;
                    obstacle_direction = angle;
                    current_distance = distance;
                }
            }
        }
        
        // Return to center position
        SetServoPosition(90);
        
        // Show scan complete message
        if (obstacle_detected) {
            sprintf(debug_text, "Obstacle at %d deg: %.1f cm", obstacle_direction, current_distance);
            SendDebugMessage(debug_text);
            UpdateLCDObstacle(current_distance, obstacle_direction);
        } else {
            SendDebugMessage("No obstacles detected within range");
            LCD_SetCursor(0, 0);
            LCD_Print("Scan Completo   ");
            LCD_SetCursor(1, 0);
            LCD_Print("No hay obstaculo");
            SysTick_ms(2000);
            UpdateLCD(target_x, target_y, yaw);
        }
        
        return;
    }
    
    // Check for "ecotest" command for HC-SR04 raw testing
    if (strcmp(lower_buffer, "ecotest") == 0) {
        SendDebugMessage("Iniciando prueba del sensor HC-SR04...");
        MotorControl(0, 0);
        estado_actual = ESTADO_DETENIDO;
        
        // Mostrar mensaje en el LCD
        LCD_SetCursor(0, 0);
        LCD_Print("Probando HC-SR04");
        LCD_SetCursor(1, 0);
        LCD_Print("                ");
        
        // Centrar el servo
        SetServoPosition(90);
        SysTick_ms(100);
        
        // Realizar varias lecturas directas
        for (int i = 0; i < 5; i++) {
            // Enviar pulso de trigger
            GPIOC->ODR &= ~(1 << ULTRASONIC_TRIG_PIN);
            SysTick_ms(5);
            GPIOC->ODR |= (1 << ULTRASONIC_TRIG_PIN);
            SysTick_Wait(160);  // 10µs a 16MHz
            GPIOC->ODR &= ~(1 << ULTRASONIC_TRIG_PIN);
            
            // Medir tiempo de eco
            uint32_t timeout = 0;
            while (!(GPIOC->IDR & (1 << ULTRASONIC_ECHO_PIN)) && timeout < 100000) {
                timeout++;
            }
            
            if (timeout >= 100000) {
                SendDebugMessage("Error: No se detectó señal ECHO HIGH");
                continue;
            }
            
            // Medir duración del pulso
            uint32_t start_time = SysTick->VAL;
            timeout = 0;
            
            while ((GPIOC->IDR & (1 << ULTRASONIC_ECHO_PIN)) && timeout < 200000) {
                timeout++;
            }
            
            if (timeout >= 200000) {
                SendDebugMessage("Error: ECHO quedó en HIGH");
                continue;
            }
            
            // Calcular duración del pulso
            uint32_t end_time = SysTick->VAL;
            uint32_t pulse_width;
            
            if (end_time <= start_time) {
                pulse_width = start_time - end_time;
            } else {
                pulse_width = (SysTick->LOAD - end_time) + start_time;
            }
            
            // Convertir a microsegundos y calcular distancia
            uint32_t pulse_us = pulse_width / 16;
            float distance = pulse_us / 58.0f;
            
            // Mostrar resultados
            sprintf(debug_text, "Pulso: %lu us = %.2f cm", pulse_us, distance);
            SendDebugMessage(debug_text);
            
            // Actualizar LCD
            sprintf(debug_text, "Prueba %d: %.2f cm", i+1, distance);
            LCD_SetCursor(1, 0);
            LCD_Print(debug_text);
            
            // Esperar entre pruebas
            SysTick_ms(500);
        }
        
        // Prueba completa
        SendDebugMessage("Prueba HC-SR04 completa");
        SysTick_ms(1000);
        UpdateLCD(target_x, target_y, yaw);
        
        return;
    }
    
    // Try multiple coordinate formats with sscanf
    int x = 0, y = 0;
    int result = 0;
    
    // Try common formats: "x,y", "x, y", "x.y"
    if (sscanf(clean_buffer, "%d,%d", &x, &y) == 2) {
        result = 2;
    } else if (sscanf(clean_buffer, "%d, %d", &x, &y) == 2) {
        result = 2;
    } else if (sscanf(clean_buffer, "%d.%d", &x, &y) == 2) {
        result = 2;
    }
    
    if (result == 2) {
        // Valid coordinates received
        target_x = x;
        target_y = y;
        
        sprintf(debug_buffer, "Parsed coordinates: %d,%d", target_x, target_y);
        SendDebugMessage(debug_buffer);
        
        // Special case for 0,0 (stop at origin)
        if (target_x == 0 && target_y == 0) {
            MotorControl(0, 0);
            estado_actual = ESTADO_DETENIDO;
            SendDebugMessage("Robot stopped at 0,0");
            
            // Update LCD
            UpdateLCD(0, 0, yaw);
            return;
        }
        
        // Convert to encoder ticks
        int tickX = (int)(target_x * TICK_FACTOR);
        int tickY = (int)(target_y * TICK_FACTOR);
        
        // Reset counters and start movement sequence
        cont_derecho = 0;
        cont_izquierdo = 0;
        ResetReferencePositions();
        
        // Update state machine
        estado_actual = ESTADO_AVANZANDO_Y;
        
        // Send acknowledgment
        sprintf(debug_text, "Moving to X=%d Y=%d (ticks: %d,%d)", 
                target_x, target_y, tickX, tickY);
        SendDebugMessage(debug_text);
    } else {
        // Invalid format - print detailed error for debugging
        sprintf(debug_buffer, "Invalid format '%s'. Use X,Y or 'stop'", clean_buffer);
        SendDebugMessage(debug_buffer);
    }
}

void SendDebugMessage(const char* message) {
    // Send a debug message via UART
    for (int i = 0; i < strlen(message); i++) {
        USART3->TDR = message[i];
        while (((USART3->ISR & 0x80) >> 7) == 0) {} // Wait for TXE
    }
    
    // Add CR+LF
    USART3->TDR = 0x0A; // Line feed
    while ((USART3->ISR & 0x80) == 0) {}
    USART3->TDR = 0x0D; // Carriage return
    while (((USART3->ISR & 0x80) >> 7) == 0) {}
}

/******************** TIMER FUNCTIONS ********************/

void ConfigureSysTick(void) {
    SysTick->LOAD = 0x00FFFFFF;
    SysTick->CTRL |= (1 << 0) | (1 << 2); // Enable SysTick and interrupt
}

void SysTick_Wait(uint32_t n) {
    SysTick->LOAD = n - 1;
    SysTick->VAL = 0;
    while ((SysTick->CTRL & 0x00010000) == 0);
}

void SysTick_ms(uint32_t x) {
    for (uint32_t i = 0; i < x; i++) {
        SysTick_Wait(16000); // 1ms at 16MHz
    }
}

void ConfigureTimer3(void) {
    // Enable TIM3 clock
    RCC->APB1ENR |= (1 << 1);
    
    // Configure TIM3 for 100Hz (10ms period)
    TIM3->PSC = 15;         // Prescaler: 16MHz/16 = 1MHz
    TIM3->ARR = 9999;       // 1MHz/10000 = 100Hz
    TIM3->CNT = 0;
    TIM3->SR = 0;
    
    // Enable update interrupt
    TIM3->DIER |= (1 << 0);
    
    // Enable timer
    TIM3->CR1 |= (1 << 0);
    
    // Enable TIM3 interrupt in NVIC
    NVIC_EnableIRQ(TIM3_IRQn);
}

void ConfigurePWM(void) {
    // Enable GPIOA and TIM5 clocks
    RCC->AHB1ENR |= (1 << 0);
    RCC->APB1ENR |= (1 << 3);
    
    // Configure TIM5 for PWM
    TIM5->ARR = 99;         // PWM period
    TIM5->PSC = 15;         // Prescaler
    TIM5->CCR1 = velocidad; // Initial duty cycle
    TIM5->DIER |= (1 << 0); // Enable update interrupt
    TIM5->CCMR1 |= (6 << 4); // PWM mode 1 on CH1
    TIM5->CCER |= (1 << 0); // Enable CH1 output
    TIM5->CR1 |= (1 << 0);  // Enable timer
    
    // Configure PA0 as TIM5_CH1
    GPIOA->MODER &= ~(3 << 0);
    GPIOA->MODER |= (2 << 0);  // Alternate function
    GPIOA->AFR[0] |= (2 << 0); // AF2 for TIM5_CH1
}

void LCD_Command(unsigned char command) {
    GPIOE->ODR = (GPIOE->ODR & 0xFF00) | command; // Envía comando (manteniendo los 8 bits superiores)
    GPIOE->ODR &= ~(1 << 8);  // RS = 0 (comando)
    GPIOE->ODR |= (1 << 9);   // E = 1
    SysTick_ms(5);
    GPIOE->ODR &= ~(1 << 9);  // E = 0
    SysTick_ms(5);
}
void LCD_Data(unsigned char data) {
    GPIOE->ODR = (GPIOE->ODR & 0xFF00) | data; // Envía dato
    GPIOE->ODR |= (1 << 8);   // RS = 1 (datos)
    GPIOE->ODR |= (1 << 9);   // E = 1
    SysTick_ms(5);
    GPIOE->ODR &= ~(1 << 9);  // E = 0
    SysTick_ms(5);
}
void LCD_Init() {
   SysTick_ms(50);  // Esperar a que el LCD se estabilice
    LCD_Command(0x38); // Modo 8 bits, 2 líneas, 5x8 caracteres
    SysTick_ms(5);
    LCD_Command(0x0C); // Display encendido, sin cursor
    SysTick_ms(5);
    LCD_Command(0x01); // Limpia pantalla
    SysTick_ms(5);
    LCD_Command(0x06); // Modo entrada, cursor a la derecha
   SysTick_ms(5);
}

void LCD_Print(char *str) {
    while (*str) {
        LCD_Data(*str++);
    }
}

void LCD_SetCursor(unsigned char row, unsigned char col) {
    unsigned char address;
    if (row == 0) {
        address = 0x80 + col; // Primera línea
    } else {
        address = 0xC0 + col; // Segunda línea
    }
    LCD_Command(address);
}

void LCD_Clear() {
    LCD_Command(0x01); // Limpia pantalla
    SysTick_ms(5);
}

// Inicialización de GPIO para el LCD (usando GPIOE)
void inicializar_GPIO() {
    RCC->AHB1ENR |= (1 << 4);  // Habilitar reloj para GPIOE
    SysTick_ms(5);
    // Configura PE0-PE7 como salida (datos)
    GPIOE->MODER &= ~0x0000FFFF;  
    GPIOE->MODER |= 0x00005555;
    // Configura PE8 y PE9 como salida (RS y E)
    GPIOE->MODER &= ~((3 << 16) | (3 << 18));
    GPIOE->MODER |= (1 << 16) | (1 << 18);
}
// Actualizar LCD con coordenadas y ángulo
void UpdateLCD(int x, int y, float angle) {
    char buffer[16];
    
    // Actualiza la línea de coordenadas
    sprintf(buffer, "X,Y: %d,%d      ", x, y);
    LCD_SetCursor(0, 0);
    LCD_Print(buffer);
    
    // Actualiza la línea de ángulo
    sprintf(buffer, "Ang: %.1f deg   ", angle);
    LCD_SetCursor(1, 0);
    LCD_Print(buffer);
}

/******************** ULTRASONIC AND SERVO FUNCTIONS ********************/

void InitializeUltrasonicSensor(void) {
    // Enable GPIOC clock
    RCC->AHB1ENR |= (1 << 2);
    
    // Configure PC10 (Trigger) as output
    GPIOC->MODER &= ~(3 << (ULTRASONIC_TRIG_PIN * 2));
    GPIOC->MODER |= (1 << (ULTRASONIC_TRIG_PIN * 2));  // Output mode
    GPIOC->OSPEEDR |= (3 << (ULTRASONIC_TRIG_PIN * 2)); // High speed for accurate timing
    
    // Configure PC11 (Echo) as input
    GPIOC->MODER &= ~(3 << (ULTRASONIC_ECHO_PIN * 2)); // Input mode (00)
    GPIOC->PUPDR &= ~(3 << (ULTRASONIC_ECHO_PIN * 2));
    GPIOC->PUPDR |= (2 << (ULTRASONIC_ECHO_PIN * 2));  // Pull-down to ensure stable low state
    
    // Initialize Trigger pin to low
    GPIOC->ODR &= ~(1 << ULTRASONIC_TRIG_PIN);
    
    // Ensure the SysTick is properly configured for precise timing
    // SysTick->LOAD = 0x00FFFFFF;  // Maximum reload value
    // SysTick->VAL = 0;           // Clear current value
    // SysTick->CTRL |= (1 << 0) | (1 << 2); // Enable SysTick and use processor clock
    
    // Send debug messages
    SendDebugMessage("Ultrasonic sensor initializing...");
    
    // Pause briefly to let the sensor stabilize
    SysTick_ms(100);
    
    // Perform a test measurement
    float test_distance = ReadUltrasonicDistance();
    char debug_str[50];
    sprintf(debug_str, "Initial test measurement: %.2f cm", test_distance);
    SendDebugMessage(debug_str);
    
    // Additional HC-SR04 debugging info
    SendDebugMessage("HC-SR04 pins: TRIG=PC10, ECHO=PC11");
    SendDebugMessage("Ultrasonic sensor initialized successfully");
}

void InitializeServo(void) {
    // Enable GPIOA and TIM2 clocks
    RCC->AHB1ENR |= (1 << 0);  // GPIOA
    RCC->APB1ENR |= (1 << 0);  // TIM2
    
    // Configure PA2 as TIM2_CH3 (alternate function)
    GPIOA->MODER &= ~(3 << (SERVO_PIN * 2));
    GPIOA->MODER |= (2 << (SERVO_PIN * 2));     // Alternate function
    GPIOA->AFR[0] &= ~(15 << (SERVO_PIN * 4));
    GPIOA->AFR[0] |= (1 << (SERVO_PIN * 4));    // AF1 (TIM2)
    
    // Configure TIM2 for PWM
    TIM2->PSC = 16 - 1;        // 1MHz (16MHz / 16)
    TIM2->ARR = 20000 - 1;     // 20ms period (50Hz)
    
    // Configure CH3 as PWM output
    TIM2->CCMR2 &= ~(7 << 4);  // Clear output mode
    TIM2->CCMR2 |= (6 << 4);   // PWM mode 1
    TIM2->CCER |= (1 << 8);    // Enable CH3 output
    
    // Set initial position (90 degrees - center position)
    SetServoPosition(90);
    
    // Enable TIM2
    TIM2->CR1 |= (1 << 0);
    
    SendDebugMessage("Servo motor initialized");
}

float ReadUltrasonicDistance(void) {
    // Implementación completamente nueva usando TIM4 para medición precisa
    
    // Habilitar reloj para TIM4 si no se ha hecho antes
    RCC->APB1ENR |= RCC_APB1ENR_TIM4EN;
    
    // Configurar TIM4 para contar a 1MHz (cada cuenta = 1µs)
    TIM4->PSC = 16-1;  // 16MHz / 16 = 1MHz
    TIM4->ARR = 0xFFFF;  // Máximo valor posible
    TIM4->CNT = 0;
    TIM4->CR1 &= ~TIM_CR1_CEN;  // Asegurar que el timer esté detenido
    
    // Preparación: Asegurar trigger bajo durante al menos 4µs
    GPIOC->ODR &= ~(1 << ULTRASONIC_TRIG_PIN);
    SysTick_ms(4);
    
    // 1. Enviar pulso de 10µs en TRIGGER
    GPIOC->ODR |= (1 << ULTRASONIC_TRIG_PIN);
    SysTick_Wait(160);  // 10µs a 16MHz
    GPIOC->ODR &= ~(1 << ULTRASONIC_TRIG_PIN);
    
    // 2. Esperar el flanco de subida de ECHO
    uint32_t timeout = 0;
    while (!(GPIOC->IDR & (1 << ULTRASONIC_ECHO_PIN))) {
        timeout++;
        if (timeout > 100000) { // Aproximadamente 6ms de timeout
            SendDebugMessage("Error: No rising edge detected on ECHO");
            return 0.0f;
        }
    }
    
    // 3. Cuando ECHO sube, iniciar el timer
    TIM4->CNT = 0;
    TIM4->CR1 |= TIM_CR1_CEN;  // Iniciar timer
    
    // 4. Esperar a que ECHO baje
    timeout = 0;
    while ((GPIOC->IDR & (1 << ULTRASONIC_ECHO_PIN))) {
        timeout++;
        if (timeout > 200000) { // Aproximadamente 12ms (más de 2m de rango)
            SendDebugMessage("Error: No falling edge detected on ECHO (stuck high)");
            TIM4->CR1 &= ~TIM_CR1_CEN;  // Detener timer
            return 0.0f;
        }
    }
    
    // 5. Cuando ECHO baja, detener el timer y leer el valor
    TIM4->CR1 &= ~TIM_CR1_CEN;  // Detener timer
    uint32_t echo_time_us = TIM4->CNT;  // Tiempo en microsegundos
    
    // IMPORTANTE: Factor de conversión para HC-SR04
    // Distancia (cm) = Tiempo (µs) / 58
    float distance_cm = (float)echo_time_us / 58.0f;
    
    // 6. Loguear datos para debug
    char debug_buf[50];
    sprintf(debug_buf, "Echo time: %lu us -> %.2f cm", echo_time_us, distance_cm);
    SendDebugMessage(debug_buf);
    
    // 7. Filtrado de valores anómalos y rango válido (2cm a 400cm)
    if (distance_cm < 2.0f || distance_cm > 400.0f) {
        SendDebugMessage("Invalid distance reading - out of range");
        return 0.0f;
    }
    
    // 8. Factor de corrección (ajustar basado en mediciones reales)
    // Si a 7cm lee 2cm, el factor es aproximadamente 7/2 = 3.5
    float correction_factor = 1.0f;
    float corrected_distance = distance_cm * correction_factor;
    
    // Limitar el valor corregido al rango válido
    if (corrected_distance > 400.0f) corrected_distance = 400.0f;
    
    sprintf(debug_buf, "Corrected distance: %.2f cm", corrected_distance);
    SendDebugMessage(debug_buf);
    
    return corrected_distance;
}

void SetServoPosition(int angle) {
    // Constrain angle to 0-180 degrees
    if (angle < 0) angle = 0;
    if (angle > 180) angle = 180;
    
    // For smoother movement, move gradually if the change is large
    static int prev_angle = 90;  // Default center position
    int angle_diff = abs(angle - prev_angle);
    
    // For large movements, move in steps
    if (angle_diff > 15) {
        int steps = angle_diff / 5;  // Move in 5-degree steps
        int dir = (angle > prev_angle) ? 1 : -1;
        
        for (int i = 1; i <= steps; i++) {
            int intermediate_angle = prev_angle + (dir * 5 * i);
            
            // Convert intermediate angle to pulse width (linear interpolation)
            uint32_t pulse_width = SERVO_MIN_PULSE + 
                ((SERVO_MAX_PULSE - SERVO_MIN_PULSE) * intermediate_angle) / 180;
            
            // Set PWM pulse width
            TIM2->CCR3 = pulse_width;
            
            // Small delay between steps
            SysTick_ms(15);
        }
    }
    
    // Final position setting
    uint32_t pulse_width = SERVO_MIN_PULSE + 
        ((SERVO_MAX_PULSE - SERVO_MIN_PULSE) * angle) / 180;
    
    // Set PWM pulse width
    TIM2->CCR3 = pulse_width;
    
    // Update global variable
    servo_position = angle;
    prev_angle = angle;
    
    // Debug the servo position occasionally (every 45 degrees)
    if (angle % 45 == 0) {
        char debug_str[50];
        sprintf(debug_str, "Servo position: %d degrees (PWM: %lu)", angle, pulse_width);
        SendDebugMessage(debug_str);
    }
    
    // Small delay to ensure the command is processed
    SysTick_ms(5);
}

void ScanForObstacles(void) {
    // Leer la distancia en la posición actual del servo
    float distance = ReadUltrasonicDistance();
    
    // Actualizar variables globales si la lectura es válida
    if (distance > 0.0f) {
        current_distance = distance;
        
        // Verificar si hay un obstáculo
        if (distance <= OBSTACLE_THRESHOLD) {
            // Registrar la posición del obstáculo detectado
            obstacle_detected = true;
            obstacle_direction = servo_position;
            
            // Mensaje de depuración (solo cuando se detecta un obstáculo)
            sprintf(debug_text, "Obstaculo: %.1f cm en %d grados", distance, servo_position);
            SendDebugMessage(debug_text);
            
            // Actualizar LCD para obstáculos críticos al frente
            if (servo_position >= 75 && servo_position <= 105) {
                UpdateLCDObstacle(distance, servo_position);
            }
        }
    }
    
    // Actualizar la posición del servo para escaneo
    static bool full_scan_mode = false;
    static int scan_counter = 0;
    
    // Cada 20 llamadas (~2 segundos), hacer un escaneo completo
    scan_counter++;
    if (scan_counter >= 20) {
        full_scan_mode = true;
        scan_counter = 0;
    }
    
    // Parámetros de escaneo según el modo
    int step_size = full_scan_mode ? 15 : 10;
    int min_angle = full_scan_mode ? 0 : 30;
    int max_angle = full_scan_mode ? 180 : 150;
    
    // Actualizar posición del servo (oscilar entre ángulos mínimo y máximo)
    servo_position += (step_size * servo_scan_direction);
    
    // Cambiar dirección en los límites
    if (servo_position >= max_angle) {
        servo_position = max_angle;
        servo_scan_direction = -1;
        full_scan_mode = false;
    } else if (servo_position <= min_angle) {
        servo_position = min_angle;
        servo_scan_direction = 1;
    }
    
    // Mover servo a la nueva posición
    SetServoPosition(servo_position);
    
    // Pequeña pausa para que el servo llegue a la posición
    SysTick_ms(20);
}

void UpdateLCDObstacle(float distance, int direction) {
    char buffer[16];
    
    // First line: Show obstacle warning
    LCD_SetCursor(0, 0);
    LCD_Print("OBSTACULO!      ");
    
    // Second line: Show distance and direction
    sprintf(buffer, "%.1fcm Dir:%d deg", distance, direction);
    LCD_SetCursor(1, 0);
    LCD_Print(buffer);
}

void HandleObstacleDetection(void) {
    static int obstacle_counter = 0;
    static float min_distance = 400.0f;
    static bool alert_sent = false;
    
    // Stop motors immediately
    MotorControl(0, 0);
    
    // Update LCD with obstacle information
    UpdateLCDObstacle(current_distance, obstacle_direction);
    
    // Keep track of minimum distance detected
    if (current_distance < min_distance && current_distance > 0.0f) {
        min_distance = current_distance;
    }
    
    // Send alert message (only once per obstacle)
    if (!alert_sent) {
        sprintf(debug_text, "ALERT: Obstacle detected at %.1f cm, direction %d degrees", 
                current_distance, obstacle_direction);
        SendDebugMessage(debug_text);
        alert_sent = true;
        
        // Make beep sound if possible (using existing hardware)
        TIM5->CCR1 = MOTOR_SPEED; // Use motor PWM for a brief moment
        SysTick_ms(50);
        TIM5->CCR1 = 0;
    }
    
    // Increment counter for persistent obstacle detection
    obstacle_counter++;
    
    // Every ~1 second, check if obstacle is still present
    if (obstacle_counter >= 100) {
        // Reset counter
        obstacle_counter = 0;
        
        // Update with latest distance
        float latest_distance = ReadUltrasonicDistance();
        
        // If distance is now greater than threshold, we can clear the obstacle state
        if (latest_distance > OBSTACLE_THRESHOLD || latest_distance < 0.0f) {
            obstacle_detected = false;
            min_distance = 400.0f;
            alert_sent = false;
            
            // Send clearance message
            SendDebugMessage("Obstacle cleared - path is now open");
            
            // Reset servo to center position
            SetServoPosition(90);
        } else {
            // Obstacle still present - update with current info
            current_distance = latest_distance;
            UpdateLCDObstacle(current_distance, obstacle_direction);
            
            // Periodic reminder about obstacle
            sprintf(debug_text, "Obstacle still present: %.1f cm", current_distance);
            SendDebugMessage(debug_text);
        }
    }
}
