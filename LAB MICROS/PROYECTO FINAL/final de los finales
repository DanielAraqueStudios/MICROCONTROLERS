                case ESTADO_GIRANDO:
                {
                    // Velocidad para el giro
                    const int VELOCIDAD_GIRO = MOTOR_SPEED*0.9;
                    
                    // Tiempo para completar el giro de 90 grados
                    static int giro_contador = 0;
                    static bool giro_iniciado = false;
                    static float GIRO_DURACION = 18.5;  // Ajustable (puede necesitar aumentarse)
                    
                    // Primera vez en este estado
                    if (!giro_iniciado) {
                        giro_contador = 0;
                        giro_iniciado = true;
                        SendDebugMessage("Iniciando giro con una rueda estática real");
                    }
                    
                    // Ejecutar el giro por tiempo fijo
                    if (giro_contador < GIRO_DURACION) {
                        // IMPORTANTE: No usar MotorControl() para el giro
                        
                        // Primero detener ambos motores
                        GPIOD->ODR &= ~((1 << 0) | (1 << 1) | (1 << 6) | (1 << 7));
                        
                        if (target_x >= 0) {
                            // Girar derecha: solo motor izquierdo hacia adelante
                            GPIOD->ODR &= ~(1 << 6);  // PD6 low
                            GPIOD->ODR |= (1 << 7);   // PD7 high
                            // Motor derecho completamente apagado (ya está por el clear anterior)
                        } else {
                            // Girar izquierda: solo motor derecho hacia adelante
                            GPIOD->ODR |= (1 << 1);   // PD1 high
                            GPIOD->ODR &= ~(1 << 0);  // PD0 low
                            // Motor izquierdo completamente apagado (ya está por el clear anterior)
                        }
                        
                        // Activar el PWM con la velocidad deseada
                        TIM5->CCR1 = VELOCIDAD_GIRO;
                        
                        giro_contador++;
                        
                        // Mostrar mensaje de depuración ocasionalmente
                        if (giro_contador % 5 == 0) {
