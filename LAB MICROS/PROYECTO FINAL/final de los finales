/******************** I2C FUNCTIONS ********************/

void ConfigI2C(void) {
    // Enable GPIOB clock
    RCC->AHB1ENR |= (1 << 1);
    
    // Configure PB8 (SCL) and PB9 (SDA) for I2C1
    GPIOB->MODER |= (1 << 19) | (1 << 17);   // Alternate function mode
    GPIOB->OTYPER |= (1 << 8) | (1 << 9);    // Open drain
    GPIOB->OSPEEDR |= (3 << 16) | (3 << 18); // Very high speed
    GPIOB->PUPDR |= (1 << 18) | (1 << 16);   // Pull-up
    GPIOB->AFR[1] |= (4 << 0) | (4 << 4);    // AF4 (I2C1)
    
    // Enable I2C1 clock and set clock source
    RCC->APB1ENR |= (1 << 21);
    RCC->DCKCFGR2 |= (2 << 16);  // HSI as clock source for I2C1
    
    // Configure I2C timing
    I2C1->CR1 &= ~(1 << 0);      // Disable I2C1 before configuring
    I2C1->TIMINGR = 0x30420F13;  // Timing value for 100kHz from 16MHz
    I2C1->CR1 |= (1 << 0);       // Enable I2C1
}

void WriteI2C1(uint8_t Direccion, uint8_t Registro, uint8_t *Dato, uint8_t Byte) {
    uint8_t n;
    
    // Configure slave address
    I2C1->CR2 &= ~(0x3FF << 0);
    I2C1->CR2 = (Direccion << 1);
    
    // Configure transfer parameters
    I2C1->CR2 &= ~(1 << 10);                // Write mode
    I2C1->CR2 &= ~(0xFF << 16);             // Clear NBYTES
    I2C1->CR2 |= ((Byte + 1) << 16);        // Set NBYTES (data + register)
    I2C1->CR2 |= (1 << 25);                 // AUTOEND mode
    
    // Start transfer
    I2C1->CR2 |= (1 << 13);
    while (!(I2C1->ISR & (1 << 1))) {}      // Wait for TXIS
    I2C1->TXDR = Registro;                  // Send register address
    
    // Send data bytes
    n = Byte;
    while (n > 0) {
        while (!(I2C1->ISR & (1 << 1))) {}  // Wait for TXIS
        I2C1->TXDR = *Dato;
        Dato++;
        n--;
    }
    
    // Wait for transfer completion
    while (!((I2C1->ISR) & (1 << 5))) {}    // Wait for STOPF
}

void ReadI2C(uint8_t Direccion, uint8_t Registro, uint8_t *Dato, uint8_t Byte) {
    uint8_t n;
    uint32_t timeout = 0;
    
    // Configure slave address
    I2C1->CR2 &= ~(0x3FF << 0);
    I2C1->CR2 = (Direccion << 1);
    
    // Write register address
    I2C1->CR2 &= ~(1 << 10);                // Write mode
    I2C1->CR2 &= ~(0xFF << 16);             // Clear NBYTES
    I2C1->CR2 |= (1 << 16);                 // Set NBYTES to 1
    I2C1->CR2 &= ~(1 << 25);                // No AUTOEND
    
    // Start transfer
    I2C1->CR2 |= (1 << 13);
    
    // Wait for TXIS with timeout
    timeout = 10000;
    while (!(I2C1->ISR & (1 << 1)) && timeout > 0) {
        timeout--;
    }
    if (timeout > 0) {
        I2C1->TXDR = Registro;                  // Send register address
    } else {
        // Handle timeout - reset I2C
        I2C1->CR1 &= ~(1 << 0);      // Disable I2C1
        SysTick_ms(1);
        I2C1->CR1 |= (1 << 0);       // Enable I2C1
        return;
    }
    
    // Wait for TC with timeout
    timeout = 10000;
    while (!((I2C1->ISR) & (1 << 6)) && timeout > 0) {
        timeout--;
    }
    if (timeout == 0) {
        // Handle timeout - reset I2C
        I2C1->CR1 &= ~(1 << 0);      // Disable I2C1
        SysTick_ms(1);
        I2C1->CR1 |= (1 << 0);       // Enable I2C1
        return;
    }
    
    // Configure read operation
    I2C1->CR2 |= (1 << 10);                 // Read mode
    I2C1->CR2 &= ~(0xFF << 16);             // Clear NBYTES
    I2C1->CR2 |= (Byte << 16);              // Set NBYTES
    I2C1->CR2 &= ~(1 << 25);                // No AUTOEND
    I2C1->CR2 |= (1 << 13);                 // Restart transfer
    
    // Read data bytes
    n = Byte;
    while (n > 0) {
        // Wait for RXNE with timeout
        timeout = 10000;
        while (!(I2C1->ISR & (1 << 2)) && timeout > 0) {
            timeout--;
        }
        
        if (timeout > 0) {
            *Dato = I2C1->RXDR;                 // Read data
            Dato++;
            n--;
        } else {
            // Handle timeout - reset I2C
            I2C1->CR1 &= ~(1 << 0);      // Disable I2C1
            SysTick_ms(1);
            I2C1->CR1 |= (1 << 0);       // Enable I2C1
            return;
        }
    }
    
    // Stop transfer
    I2C1->CR2 |= (1 << 14);                 // STOP
    
    // Wait for STOPF with timeout
    timeout = 10000;
    while (!(I2C1->ISR & (1 << 5)) && timeout > 0) {
        timeout--;
    }
    
    if (timeout > 0) {
        I2C1->ICR |= (1 << 5);                  // Clear STOPF
    } else {
        // Handle timeout - reset I2C
        I2C1->CR1 &= ~(1 << 0);      // Disable I2C1
        SysTick_ms(1);
        I2C1->CR1 |= (1 << 0);       // Enable I2C1
    }
}

void ConfigMPU6050(void) {
    // Wake up the MPU6050 from sleep mode
    mpu_cmd[0] = 0x00;
    WriteI2C1(MPU6050_ADDR, MPU_PWR_MGMT_1, mpu_cmd, 1);
    SysTick_ms(10);
    
    // Set gyro range to ±250°/s and accel range to ±2g
    mpu_cmd[0] = 0x00;  // 250 deg/s
    WriteI2C1(MPU6050_ADDR, MPU_GYRO_CONFIG, mpu_cmd, 1);
    mpu_cmd[0] = 0x00;  // 2g
    WriteI2C1(MPU6050_ADDR, MPU_ACCEL_CONFIG, mpu_cmd, 1);
    SysTick_ms(10);
    
    // Set DLPF (Digital Low Pass Filter)
    mpu_cmd[0] = 0x03;  // ~44Hz cutoff frequency
    WriteI2C1(MPU6050_ADDR, MPU_CONFIG, mpu_cmd, 1);
    SysTick_ms(10);
}

void ReadMPU6050Data(void) {
    // Read 14 bytes of data from MPU6050 with timeout protection
    uint32_t timeout = 100000;  // Set a timeout value
    uint32_t start_time = 0;
    
    // Use a timeout to prevent getting stuck in I2C operations
    start_time = SysTick->VAL;
    ReadI2C(MPU6050_ADDR, MPU_DATA_REG, mpu_data_buffer, 14);
    
    // Extract raw data
    raw_accelx = (mpu_data_buffer[0] << 8) | mpu_data_buffer[1];
    raw_accely = (mpu_data_buffer[2] << 8) | mpu_data_buffer[3];
    raw_accelz = (mpu_data_buffer[4] << 8) | mpu_data_buffer[5];
    
    // Skip temperature (bytes 6-7)
    
    raw_gyrox = (mpu_data_buffer[8] << 8) | mpu_data_buffer[9];
    raw_gyroy = (mpu_data_buffer[10] << 8) | mpu_data_buffer[11];
    raw_gyroz = (mpu_data_buffer[12] << 8) | mpu_data_buffer[13];
    
    // Convert to physical units
    gyrox = raw_gyrox * (250.0f / 32768.0f);
    gyroy = raw_gyroy * (250.0f / 32768.0f);
    gyroz = raw_gyroz * (250.0f / 32768.0f);
    
    // Apply calibration offsets if calibrated
    if (gyro_calibrated) {
        gyrox -= gyro_offset_x;
        gyroy -= gyro_offset_y;
        gyroz -= gyro_offset_z;
    }
    
    accelx = raw_accelx * (2.0f / 32768.0f);
    accely = raw_accely * (2.0f / 32768.0f);
    accelz = raw_accelz * (2.0f / 32768.0f);
    
    // Update yaw angle with drift limitation
    float yaw_change = gyroz * DT;
    
    // Limit drift by ignoring very small changes
    if (fabs(yaw_change) < 0.01f) {
        yaw_change = 0.0f;
    }
    
    // Apply change to yaw
    yaw += yaw_change;
    
    // Normalize yaw to 0-360 range
    while (yaw >= 360.0f) yaw -= 360.0f;
    while (yaw < 0.0f) yaw += 360.0f;
}

void CalibrateGyroscope(void) {
    // Increase number of samples for better calibration
    const int num_samples = 100;
    float sum_x = 0.0f, sum_y = 0.0f, sum_z = 0.0f;
    
    // Display calibration message on LCD
    LCD_SetCursor(0, 0);
    LCD_Print("Calibrating...");
    LCD_SetCursor(1, 0);
    LCD_Print("Keep robot still");
    
    // Send debug message and ensure it's sent
    SendDebugMessage("Starting gyroscope calibration...");
    
    // Brief delay for sensor to settle
    SysTick_ms(100);
    
    // Reset yaw to 0 before calibration
    yaw = 0.0f;
    
    // Take samples to average the offset with timeout protection
    int timeout_counter = 0;
    for (int i = 0; i < num_samples && timeout_counter < 1000; i++) {
        // Read sensor data (raw, without applying existing offsets)
        ReadI2C(MPU6050_ADDR, MPU_DATA_REG, mpu_data_buffer, 14);
        
        // Extract gyro data
        raw_gyrox = (mpu_data_buffer[8] << 8) | mpu_data_buffer[9];
        raw_gyroy = (mpu_data_buffer[10] << 8) | mpu_data_buffer[11];
        raw_gyroz = (mpu_data_buffer[12] << 8) | mpu_data_buffer[13];
        
        // Convert to degrees per second
        float gx = raw_gyrox * (250.0f / 32768.0f);
        float gy = raw_gyroy * (250.0f / 32768.0f);
        float gz = raw_gyroz * (250.0f / 32768.0f);
        
        // Update LCD to show progress
        if (i % 10 == 0) {
            char progress[16];
            sprintf(progress, "Progress: %d%%  ", (i * 100) / num_samples);
            LCD_SetCursor(1, 0);
            LCD_Print(progress);
        }
        
        // Filter out extreme values that could skew calibration
        if (fabs(gx) < 20.0f && fabs(gy) < 20.0f && fabs(gz) < 20.0f) {
            sum_x += gx;
            sum_y += gy;
            sum_z += gz;
        } else {
            // Skip this sample but don't increment i
            i--;
            // Prevent infinite loop
            timeout_counter++;
            continue;
        }
        
        // Small delay between readings
        SysTick_ms(10);
        
        timeout_counter++;
    }
    
    // Calculate and apply offsets
    if (timeout_counter < 1000) {
        // Normal calculation
        gyro_offset_x = sum_x / num_samples;
        gyro_offset_y = sum_y / num_samples;
        gyro_offset_z = sum_z / num_samples;
        
        // Cap maximum offset values to prevent unreasonable values
        if (fabs(gyro_offset_z) > 5.0f) {
            gyro_offset_z = (gyro_offset_z > 0) ? 5.0f : -5.0f;
            SendDebugMessage("Warning: Z offset capped to reasonable value");
        }
    } else {
        // Timeout occurred, use safe defaults
        gyro_offset_x = 0.0f;
        gyro_offset_y = 0.0f;
        gyro_offset_z = 0.0f;
        SendDebugMessage("Calibration timeout! Using default values");
    }
    
    // Set calibrated flag
    gyro_calibrated = true;
    
    // Reset yaw to 0 after calibration
    yaw = 0.0f;
    
    // Display calibration results
    char buffer[16];
    sprintf(buffer, "X:%.2f Y:%.2f", gyro_offset_x, gyro_offset_y);
    LCD_SetCursor(0, 0);
    LCD_Print(buffer);
    
    sprintf(buffer, "Z:%.2f", gyro_offset_z);
    LCD_SetCursor(1, 0);
    LCD_Print(buffer);
    
    // Send calibration results via UART
    char debug_buffer[50];
    sprintf(debug_buffer, "Gyro offsets: X=%.2f Y=%.2f Z=%.2f", 
            gyro_offset_x, gyro_offset_y, gyro_offset_z);
    SendDebugMessage(debug_buffer);
    
    // Clear message to indicate completion
    LCD_SetCursor(0, 0);
    LCD_Print("Calibration OK ");
    
    // Brief delay to show results
    SysTick_ms(50);
    
    // Send confirmation of completion
    SendDebugMessage("Gyroscope calibration completed successfully");
}

/******************** MOTOR CONTROL FUNCTIONS ********************/

void InitializeMotorControl(void) {
    // Enable GPIOD clock
    RCC->AHB1ENR |= (1 << 3);
    
    // Configure motor control pins (PD0, PD1, PD6, PD7) as outputs
    GPIOD->MODER &= ~((3 << 0) | (3 << 2) | (3 << 12) | (3 << 14));
    GPIOD->MODER |= ((1 << 0) | (1 << 2) | (1 << 12) | (1 << 14));
    
    // Initialize motors to stop
    GPIOD->ODR &= ~((1 << 0) | (1 << 1) | (1 << 6) | (1 << 7));
}

void InitializeEncoders(void) {
    // Enable GPIOD and SYSCFG clocks
    RCC->AHB1ENR |= (1 << 3);
    RCC->APB2ENR |= (1 << 14);
    
    // Configure PD4 (left encoder)
    SYSCFG->EXTICR[1] |= (3 << 0);    // PD4 as source for EXTI4
    GPIOD->PUPDR |= (2 << 8);         // Pull-down
    EXTI->IMR |= (1 << 4);            // Enable interrupt
    EXTI->FTSR |= (1 << 4);           // Falling edge trigger
    EXTI->PR |= (1 << 4);             // Clear pending flag
    NVIC_EnableIRQ(EXTI4_IRQn);
    
    // Configure PD5 (right encoder)
    SYSCFG->EXTICR[1] |= (3 << 4);    // PD5 as source for EXTI5
    GPIOD->PUPDR |= (2 << 10);        // Pull-down
    EXTI->IMR |= (1 << 5);            // Enable interrupt
    EXTI->FTSR |= (1 << 5);           // Falling edge trigger
    EXTI->PR |= (1 << 5);             // Clear pending flag
    NVIC_EnableIRQ(EXTI9_5_IRQn);
    
    // Reset counters
    cont_derecho = 0;
    cont_izquierdo = 0;
}

void MotorControl(int left_speed, int right_speed) {
    // Control motor directions based on speed sign
    
    left_speed = -left_speed;  
    right_speed = -right_speed;

    // Left motor (Invertido para corregir dirección)
    if (left_speed >= 0) {
        // Forward - Conexiones invertidas
        GPIOD->ODR &= ~(1 << 6);      // Set PD6 low
        GPIOD->ODR |= (1 << 7);       // Set PD7 high
    } else {
        // Backward - Conexiones invertidas
        GPIOD->ODR |= (1 << 6);       // Set PD6 high
        GPIOD->ODR &= ~(1 << 7);      // Set PD7 low
    }
    
    // Right motor
    if (right_speed >= 0) {
        // Forward
        GPIOD->ODR |= (1 << 1);       // Set PD1 high
        GPIOD->ODR &= ~(1 << 0);      // Set PD0 low
    } else {
        // Backward
        GPIOD->ODR &= ~(1 << 1);      // Set PD1 low
        GPIOD->ODR |= (1 << 0);       // Set PD0 high
    }
    
    // Adjust PWM duty cycle based on absolute speed values
    TIM5->CCR1 = (left_speed != 0 || right_speed != 0) ? MOTOR_SPEED : 0;
}

void SetReferencePositions(void) {
    if (!referencias_configuradas) {
        ref_derecho = cont_derecho;
        ref_izquierdo = cont_izquierdo;
        target_yaw = yaw;
        referencias_configuradas = true;
    }
}

void ResetReferencePositions(void) {
    referencias_configuradas = false;
}

bool MoveDistance(int ticks) {
    // Ensure reference positions are set
    SetReferencePositions();
    
    // Calculate the distance traveled
    int left_distance = abs(cont_izquierdo - ref_izquierdo);
    int right_distance = abs(cont_derecho - ref_derecho);
    int avg_distance = (left_distance + right_distance) / 2;
    
    // Check for obstacles in front when moving forward
    if (obstacle_detected && servo_position >= 60 && servo_position <= 120) {
        // Stop immediately for obstacle directly ahead
        MotorControl(0, 0);
        SendDebugMessage("Movement stopped due to obstacle ahead");
        return true;  // Consider movement complete to prevent further attempts
    }
    
    // Debug info with enhanced information
    if (debug_counter % 50 == 0) {  // Send debug messages every ~500ms
        sprintf(debug_text, "Move: L=%d, R=%d, Target=%d, Avg=%d, State=%d", 
                left_distance, right_distance, abs(ticks), avg_distance, estado_actual);
        SendDebugMessage(debug_text);
    }
    
    // Check if we've reached or exceeded target distance
    if (avg_distance >= abs(ticks) || left_distance >= abs(ticks) || right_distance >= abs(ticks)) {
        // Stop motors immediately
        MotorControl(0, 0);
        
        // Include the current state in the log message
        if (estado_actual == ESTADO_AVANZANDO_Y) {
            SendDebugMessage("Y distance reached - stopping");
        } else if (estado_actual == ESTADO_AVANZANDO_X) {
            SendDebugMessage("X distance reached - stopping");
        } else {
            SendDebugMessage("Distance reached - stopping");
        }
        
        ResetReferencePositions();
        return true;  // Movement complete
    } 
    // Safety timeout: if we've moved significantly more than expected, stop anyway
    else if (avg_distance > abs(ticks) * 1.5) {
        MotorControl(0, 0);
        SendDebugMessage("Safety limit exceeded - stopping");
        ResetReferencePositions();
        return true;
    }
    else {
        // Direction based on the sign of the target ticks
        int base_speed = MOTOR_SPEED;
        
        // Adjust motor speeds based on current state
        int left_speed = base_speed;
        int right_speed = base_speed;
        
        // Apply different speed adjustments based on axis of movement
        if (estado_actual == ESTADO_AVANZANDO_Y) {
            // For Y movement, we need right-side compensation (70% faster)
            right_speed = base_speed + (int)(base_speed * 0.70);
        } else if (estado_actual == ESTADO_AVANZANDO_X) {
            // For X movement (after turning), use more balanced speeds
            // with a slight compensation for any drift
            right_speed = base_speed + (int)(base_speed * 0.20);
        }
        
        // Apply direction based on state and target
        if (estado_actual == ESTADO_AVANZANDO_Y && target_y < 0) {
            // For Y movement, negative Y means move backward
            MotorControl(-left_speed, -right_speed);
        } 
        else if (estado_actual == ESTADO_AVANZANDO_X && target_x < 0) {
            // For X movement, negative X means move backward
            MotorControl(left_speed, right_speed);
        }
        else {
            // Otherwise move forward with appropriate compensation
            MotorControl(left_speed, right_speed);
        }
        return false; // Still moving
    }
}

bool Turn(float angle) {
    // Ensure reference angle is set
    SetReferencePositions();
    
    // Store our target angle as a value between 0-360
    static float absolute_target_angle = 0.0f;
    static bool target_initialized = false;
    static int turn_timeout = 0;
    
    // Initialize target angle on first call
    if (!target_initialized) {
        // Calculate target angle in absolute terms (0-360 range)
        absolute_target_angle = target_yaw + angle;
        
        // Normalize to 0-360 range
        while (absolute_target_angle >= 360.0f) absolute_target_angle -= 360.0f;
        while (absolute_target_angle < 0.0f) absolute_target_angle += 360.0f;
        
        target_initialized = true;
        turn_timeout = 0;
        
        sprintf(debug_text, "Turn initialized: Target=%.1f, Current=%.1f", 
                absolute_target_angle, yaw);
        SendDebugMessage(debug_text);
    }
    
    // Calculate the smallest angular distance to target (considering the circle)
    float angular_distance = absolute_target_angle - yaw;
    
    // Normalize to -180 to +180 range for shortest turn direction
    if (angular_distance > 180.0f) angular_distance -= 360.0f;
    if (angular_distance < -180.0f) angular_distance += 360.0f;
    
    // Debug info with more frequent updates
    if (debug_counter % 50 == 0) {
        sprintf(debug_text, "Turn: Current=%.1f, Target=%.1f, Distance=%.1f, Timeout=%d", 
                yaw, absolute_target_angle, angular_distance, turn_timeout);
        SendDebugMessage(debug_text);
    }
    
    // Increment timeout counter
    turn_timeout++;
    
    // Check if we've completed the turn within threshold or timeout exceeded
    if (fabs(angular_distance) < TURN_THRESHOLD || turn_timeout > 500) {
        // Stop motors
        MotorControl(0, 0);
        
        // Send appropriate message
        if (turn_timeout > 500) {
            SendDebugMessage("Turn safety timeout triggered - stopping");
        } else {
            SendDebugMessage("Turn completed - target angle reached");
        }
        
        // Reset turn variables
        target_initialized = false;
        turn_timeout = 0;
        
        // DO NOT reset references here, let the state machine handle it
        // ResetReferencePositions();
        
        return true;  // Turn complete
    } else {
        // Determine turn direction based on shortest path
        bool turn_right = (angular_distance > 0);
        
        // Calculate speed based on distance to target (slower as we approach)
        int base_speed = MOTOR_SPEED;
        float speed_factor = 1.0f;
        
        // Reduce speed when close to target angle for more precision
        if (fabs(angular_distance) < 30.0f) {
            speed_factor = 0.5f;  // 50% speed when within 30 degrees
        }
        if (fabs(angular_distance) < 10.0f) {
            speed_factor = 0.3f;  // 30% speed when within 10 degrees
        }
        
        int turn_speed = (int)(base_speed * speed_factor);
        
        // Apply turn with variable speed
        if (turn_right) {
            // Turn right (clockwise)
            MotorControl(turn_speed, -turn_speed);
        } else {
            // Turn left (counter-clockwise)
            MotorControl(-turn_speed, turn_speed);
        }
        
        return false; // Still turning
    }
}

